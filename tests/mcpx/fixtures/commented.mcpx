; Hand-written copy of the canonical example with notes.
; The serializer drops every comment line; pixels and semantics stay identical.
mcpx 1

[canvas]
width = 16
height = 16

; Canvas-level metadata follows.
[metadata]
name = iron_sword
type = item

[palette]
; Transparent keeps the reserved dot symbol.
. = transparent
O = #25282BFF role=outline
D = #707A84FF role=shadow
S = #ADB7C0FF role=base
H = #E1E7EAFF role=highlight
W = #6F4730FF

[layer base]
visible = true
opacity = 1

[grid]
................
.......H........
.......SS.......
......SSD.......
......SSD.......
.....SSD........
.....SSD........
....SSD.........
....SSD.........
...SSD..........
..OOOOOOO.......
.....WW.........
.....WW.........
.....WW.........
.....OO.........
................

; The blade region below drives recolor, not rendering.
[region blade]
name = Blade

[mask]
................
.......#........
.......##.......
......###.......
......###.......
.....###........
.....###........
....###.........
....###.........
...###..........
................
................
................
................
................
................
