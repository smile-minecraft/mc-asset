; Tile showcase source: 32x32 hand-built running-bond brick, seamless by construction.
; Vertical: 3px brick + 1px mortar x8 courses (32/4=8); a course straddles the top/bottom edge ({31,0,1}) so top==bottom.
; Horizontal: 7px brick + 1px mortar, period 8; odd courses offset 4; even mortar x%8==2, odd x%8==6, so left==right (edges fall mid-brick).
; Colors: stone trio - mortar #17171A, even courses #A3A3AB, odd courses #E8E8EE. All periods divide 32.
[palette]
M = #17171A
A = #A3A3AB
B = #E8E8EE

